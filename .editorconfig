# https://editorconfig.org  — consistent whitespace across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[Makefile]
indent_style = tab

# Markdown: keep trailing whitespace (two spaces is a hard line break).
[*.md]
trim_trailing_whitespace = false
