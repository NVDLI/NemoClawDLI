    },
    {
      "path": "docs/security-architecture.svg",
      "kind": "generated-architecture-diagram",
      "license": "generated-from-authored-source",
      "disposition": "review-neutral projection of docs/security-architecture.json"
    },
    {
      "path": "scripts/browser-vendor",
      "kind": "browser-dependency-build-inputs",
      "license": "mixed-per-package-lock-and-license-files",
      "disposition": "exact npm inputs, lock, publisher distribution paths, one browser-compatibility entrypoint, and upstream license overrides"
    },
    {
      "path": "web/nemoclaw/vendor",
      "kind": "vendored-browser-dependencies",
      "license": "mixed-per-browser-dependencies-manifest",
      "disposition": "same-origin publisher file copies, one unminified browser-compatibility bundle, package inventory, artifact hashes, and per-package license evidence"
    },
    {
      "path": "web/shared/vendor",
      "kind": "shared-vendored-browser-dependencies",
      "license": "mixed-per-browser-dependencies-manifest",
      "disposition": "course-neutral byte-identical copies of reviewed CodeMirror, Highlight.js, and Marked publisher assets with complete license and digest evidence"
    },
    {
      "path": "web/shared/favicon.ico",
      "kind": "shared-course-asset",
      "license": "external-terms",
      "disposition": "unmodified NVIDIA corporate favicon; NVIDIA Logo and Brand Guidelines and trademark rights apply"
    }
  ],
  "forbidden_private_link_regexes": [
    {
      "name": "company shortlink",
      "pattern": "https?://nv/[^\\s)\"<>]+"
    },
    {
      "name": "internal wiki host",
      "pattern": "https?://[^\\s)\"<>]*atlassian\\.net/[^\\s)\"<>]*"
    },
    {
      "name": "private git host",
      "pattern": "https?://[^\\s)\"<>]*(gitlab-master|github-onboarding)[^\\s)\"<>]*"
    },
    {
      "name": "private service host",
      "pattern": "https?://[^\\s)\"<>]*\\.nvidia\\.(?:net|internal)/[^\\s)\"<>]*"
    }
  ]
}
