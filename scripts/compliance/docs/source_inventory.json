{
  "schema": "source-inventory/1.0",
  "default_license": "Apache-2.0",
  "contribution_terms": "Inbound contributions are Apache-2.0 unless explicitly marked Not a Contribution.",
  "policy_docs": [
    "scripts/compliance/docs/open_source_readiness.md",
    "scripts/compliance/docs/vendor_policy.md"
  ],
  "provenance_beacons": [
    {
      "root": "web/nemoclaw/assets",
      "beacon": "web/nemoclaw/assets/SKILL.html",
      "arrays": [
        "figures",
        "assets"
      ]
    },
    {
      "root": "web/nemoclaw/mats",
      "beacon": "web/nemoclaw/mats/SKILL.html",
      "arrays": [
        "mats",
        "figures",
        "assets"
      ]
    }
  ],
  "inventory_entries": [
    {
      "path": "LICENSE",
      "kind": "license",
      "license": "Apache-2.0",
      "disposition": "required root license"
    },
    {
      "path": "DCO.md",
      "kind": "contribution_certificate",
      "license": "DCO-1.1",
      "disposition": "complete verbatim Developer Certificate of Origin 1.1 and signoff guidance"
    },
    {
      "path": "THIRD-PARTY-NOTICES.md",
